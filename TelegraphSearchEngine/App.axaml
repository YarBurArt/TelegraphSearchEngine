<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegraphSearchEngine.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <!-- simple instead of fluent: fluent's dark palette paints a #000
             window, simple's is #282828 and follows the system variant -->
        <SimpleTheme />
    </Application.Styles>
</Application>
